<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net9.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>beatleader_analyzer</RootNamespace>
	  <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.13.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Runtime.InteropServices" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parser\beatleader-parser\Parser.csproj" />
  </ItemGroup>

  <!-- Parity model (BeatmapScanner/Parity/MlParityModel.cs), exported by beatsaber-replays-ai-2 paritymodel/production.py -->
  <ItemGroup>
    <EmbeddedResource Include="BeatmapScanner\Parity\parity_nn.onnx" LogicalName="Analyzer.Parity.parity_nn.onnx" />
    <EmbeddedResource Include="BeatmapScanner\Parity\parity_trees.gzbin" LogicalName="Analyzer.Parity.parity_trees.gzbin" />
  </ItemGroup>

</Project>
